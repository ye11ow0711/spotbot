# Хранение языковых предпочтений пользователей
user_languages = {}


# Команда /start с выбором языка
@dp.message_handler(Command("start"))
async def start(message: types.Message):
    await message.answer(
        text=TEXTS["ru"]["choose_language"],
        reply_markup=language_keyboard()
    )


@dp.callback_query_handler(lambda c: c.data == "back_to_language")
async def back_to_language(callback: types.CallbackQuery):
    await callback.message.edit_text(
        text=TEXTS["ru"]["choose_language"],
        reply_markup=language_keyboard()
    )


# Обработчик выбора языка
@dp.callback_query_handler(lambda c: c.data.startswith("lang_"))
async def set_language(callback: types.CallbackQuery):
    lang = callback.data.split("_")[1]
    user_languages[callback.from_user.id] = lang

    await callback.message.edit_text(
        text=TEXTS[lang]["start"],
        reply_markup=main_menu(lang)
    )


# Выбор товара
@dp.callback_query_handler(lambda c: c.data in ["spotify", "youtube"])
async def callback_handler(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")

    if callback.data == "spotify":
        product_name = TEXTS[lang]["spotify"]
    else:
        product_name = TEXTS[lang]["youtube"]

    await callback.message.edit_text(
        text=TEXTS[lang]["choose_duration"].format(product=product_name),
        reply_markup=duration_menu(callback.data, lang)
    )


# Выбор срока подписки
@dp.callback_query_handler(lambda c: c.data.startswith("spotify_") or c.data.startswith("youtube_"))
async def subscription_detail(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    product, months_str = callback.data.split("_")
    months = int(months_str)
    price = PRODUCTS[product][months]

    # Локализация текста с месяцами
    if lang == "ru":
        months_text = f"{months} месяцев"
    else:
        months_text = f"{months} months"

    if product == "spotify":
        text = TEXTS[lang]["spotify_desc"].format(months=months_text, price=price)
    else:
        text = TEXTS[lang]["youtube_desc"].format(months=months_text, price=price)

    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton(text=TEXTS[lang]["buy"], callback_data=f"buy_{product}_{months}"))
    kb.add(InlineKeyboardButton(text=TEXTS[lang]["back"], callback_data=product))

    await callback.message.edit_text(text=text, reply_markup=kb)


# Обработка покупки
@dp.callback_query_handler(lambda c: c.data.startswith("buy_"))
async def process_purchase(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    _, product, months = callback.data.split("_")

    # Уведомление об ожидании оплаты
    await callback.message.edit_text(TEXTS[lang]["payment_wait"])

    # Симуляция проверки оплаты
    await asyncio.sleep(2)

    # Проверка оплаты (заглушка)
    payment_success = True

    if payment_success:
        account_data = get_next_account()
        if account_data:
            text = TEXTS[lang]["account_details"].format(
                email=account_data['email'],
                email_password=account_data['email_password'],
                region=account_data['region'],
                spotify_password=account_data['spotify_password']
            )
            await callback.message.edit_text(text)
        else:
            await callback.message.edit_text(TEXTS[lang]["no_accounts"])
    else:
        await callback.message.edit_text(TEXTS[lang]["payment_failed"])


