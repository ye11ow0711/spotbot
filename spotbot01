# Хранение языков и покупок пользователей
user_languages = {}
user_purchases = {}  # {user_id: [list_of_accounts]}

def get_next_account():
    for acc in ACCOUNTS_DATABASE:
        if not acc['used']:
            acc['used'] = True
            return acc
    return None

def language_keyboard():
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text="🇷🇺 Русский", callback_data="lang_ru"),
         InlineKeyboardButton(text="🇺🇸 English", callback_data="lang_en")]
    ])

def main_menu(lang="ru"):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=TEXTS[lang]["spotify"], callback_data="spotify")],
        [InlineKeyboardButton(text=TEXTS[lang]["youtube"], callback_data="youtube")],
        [InlineKeyboardButton(text=TEXTS[lang]["purchases"], callback_data="purchases")],  
        [InlineKeyboardButton(text=TEXTS[lang]["back_to_language"], callback_data="back_to_language")],
        [InlineKeyboardButton(text=TEXTS[lang]["support"], url="https://t.me/w1nk1e")]
    ])

def duration_menu(product, lang="ru"):
    kb = []
    for m in [6, 8, 10, 12]:
        text = f"{m} месяцев {PRODUCTS[product][m]}₽" if lang == "ru" else f"{m} months {PRODUCTS[product][m]}₽"
        kb.append([InlineKeyboardButton(text=text, callback_data=f"{product}_{m}")])
    kb.append([InlineKeyboardButton(text=TEXTS[lang]["back"], callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=kb)

def back_to_main_menu(lang="ru"):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=TEXTS[lang]["back"], callback_data="back_main")]
    ])

# Хендлеры
@dp.message(Command("start"))
async def start(message: types.Message):
    await message.answer(TEXTS["ru"]["choose_language"], reply_markup=language_keyboard())

@dp.callback_query(F.data.startswith("lang_"))
@dp.callback_query(F.data.startswith("lang_"))
async def set_language(callback: types.CallbackQuery):
    lang = callback.data.split("_")[1]
    user_languages[callback.from_user.id] = lang
    await callback.message.edit_text(TEXTS[lang]["start"], reply_markup=main_menu(lang))

@dp.callback_query(F.data.in_(["spotify", "youtube"]))
async def choose_product(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    product_name = TEXTS[lang][callback.data]
    await callback.message.edit_text(TEXTS[lang]["choose_duration"].format(product=product_name),
                                     reply_markup=duration_menu(callback.data, lang))

@dp.callback_query(F.data.startswith("spotify_") | F.data.startswith("youtube_"))
async def choose_duration(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    product, months_str = callback.data.split("_")
    months = int(months_str)
    price = PRODUCTS[product][months]
    months_text = f"{months} месяцев" if lang == "ru" else f"{months} months"
    text = TEXTS[lang][f"{product}_desc"].format(months=months_text, price=price)
    kb = InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(text=TEXTS[lang]["buy"], callback_data=f"buy_{product}_{months}")],
        [InlineKeyboardButton(text=TEXTS[lang]["back"], callback_data=product)]
    ])
    await callback.message.edit_text(text, reply_markup=kb)

@dp.callback_query(F.data.startswith("buy_"))
async def buy_account(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    _, product, months = callback.data.split("_")
    await callback.message.edit_text(TEXTS[lang]["payment_wait"])
    await asyncio.sleep(2)  # заглушка оплаты
    payment_success = True
    if payment_success:
        account = get_next_account()
        if account:
            # Сохр покупки
            user_purchases.setdefault(callback.from_user.id, []).append(account)
            text = TEXTS[lang]["account_details"].format(
                email=account['email'],
                email_password=account['email_password'],
                region=account['region'],
                spotify_password=account['spotify_password']
            )
            await callback.message.edit_text(text, reply_markup=back_to_main_menu(lang))
        else:
            await callback.message.edit_text(TEXTS[lang]["no_accounts"], reply_markup=back_to_main_menu(lang))
    else:
        await callback.message.edit_text(TEXTS[lang]["payment_failed"], reply_markup=back_to_main_menu(lang))

@dp.callback_query(F.data == "purchases")
async def show_purchases(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    purchases = user_purchases.get(callback.from_user.id, [])
    if not purchases:
        await callback.message.edit_text(TEXTS[lang]["no_purchases"], reply_markup=back_to_main_menu(lang))
    else:
        text = TEXTS[lang]["purchases"] + ":\n\n"
        for idx, acc in enumerate(purchases, start=1):
            text += f"#{idx}\n📧 {acc['email']}\n🔑 {acc['email_password']}\n🌍 {acc['region']}\n🎵 {acc['spotify_password']}\n\n"
        await callback.message.edit_text(text, reply_markup=back_to_main_menu(lang))

@dp.callback_query(F.data == "back_main")
async def back_main(callback: types.CallbackQuery):
    lang = user_languages.get(callback.from_user.id, "ru")
    await callback.message.edit_text(TEXTS[lang]["start"], reply_markup=main_menu(lang))

@dp.callback_query(F.data == "back_to_language")
async def back_to_language(callback: types.CallbackQuery):
    await callback.message.edit_text(TEXTS["ru"]["choose_language"], reply_markup=language_keyboard())

# Запуск
async def main():
    print("Бот запущен...")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
